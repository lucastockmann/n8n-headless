# n8n Configuration
# Copy this file to .env and update values

# Basic Authentication (recommended for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# Encryption key for credentials (IMPORTANT: generate a secure key)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your-encryption-key-here

# Webhook URL (set to your Railway domain)
WEBHOOK_URL=https://your-app.railway.app

# Timezone
GENERIC_TIMEZONE=UTC
TZ=UTC

# Database (optional - uses SQLite by default)
# For PostgreSQL on Railway:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=your-postgres-host
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=postgres
# DB_POSTGRESDB_PASSWORD=your-db-password

# Executions settings
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Queue mode (for scaling)
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=your-redis-host
# QUEUE_BULL_REDIS_PORT=6379

# ===========================================
# Browserless Configuration (Headless Chrome)
# ===========================================

# WebSocket endpoint for Puppeteer to connect to Browserless
# Local: ws://browserless:3000
# Railway: ws://browserless.railway.internal:3000
PUPPETEER_WS_ENDPOINT=ws://browserless:3000

# Browserless settings
BROWSERLESS_MAX_SESSIONS=5
BROWSERLESS_TIMEOUT=60000
# Optional: Set a token to secure the browserless endpoint
# BROWSERLESS_TOKEN=your-secure-token
